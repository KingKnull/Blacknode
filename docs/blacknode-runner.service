[Unit]
Description=Blacknode infrastructure runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=blacknode
Group=blacknode
StateDirectory=blacknode-runner
UMask=0077
ExecStart=/opt/blacknode/blacknode-runner --database /var/lib/blacknode-runner/blacknode.db --token-file /etc/blacknode-runner/admin-token --vault-password-file /etc/blacknode-runner/vault-password --listen 127.0.0.1:9250
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
