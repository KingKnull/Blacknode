{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.blacknode.app",
  "productName": "Blacknode",
  "copyright": "Copyright © 2026 Blacknode",
  "directories": {
    "output": "../dist_electron"
  },
  "files": [
    "main.js",
    "preload.js",
    "../frontend/dist/**/*"
  ],
  "extraResources": [
    {
      "from": "../bin",
      "to": "backend",
      "filter": ["blacknode-server*"]
    }
  ],
  "linux": {
    "maintainer": "Blacknode Team <dev@blacknode.app>",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "category": "Utility",
    "icon": "../build/appicon.png"
  },
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.developer-tools",
    "icon": "../build/appicon.png"
  },
  "win": {
    "target": ["nsis"],
    "icon": "../build/appicon.png"
  }
}
